      <item1>
        <securityTitle>Depositary Units Representing Limited Partner Interests</securityTitle>
        <issuerName>Icahn Enterprises L.P.</issuerName>
        <issuerPrincipalAddress>
          <com:street1>16690 COLLINS AVE,</com:street1>
          <com:street2>PH-1</com:street2>
          <com:city>SUNNY ISLES BEACH</com:city>
